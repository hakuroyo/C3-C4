<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="ocean_fog">
    <scene>
      <ambient>0.18 0.20 0.22 1</ambient>
      <background>0.58 0.64 0.68 1</background>
      <shadows>false</shadows>
      <fog>
        <type>linear</type>
        <color>0.62 0.68 0.70 1</color>
        <start>3.0</start>
        <end>38.0</end>
        <density>0.08</density>
      </fog>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.2</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <light name="diffuse_sun" type="directional">
      <pose>0 0 80 0 0 0</pose>
      <diffuse>0.55 0.56 0.54 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.2 0.4 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="foggy_ocean_surface">
      <static>true</static>
      <link name="water">
        <visual name="water_visual">
          <pose>0 0 -0.04 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 600</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.18 0.22 0.82</ambient>
            <diffuse>0.08 0.30 0.36 0.82</diffuse>
            <specular>0.10 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="navigation_marker_port">
      <static>true</static>
      <pose>18 6 0.55 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.05 0.03 1</ambient>
            <diffuse>0.75 0.05 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="navigation_marker_starboard">
      <static>true</static>
      <pose>24 -7 0.55 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.55 0.10 1</ambient>
            <diffuse>0.02 0.55 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="depth_camera_model">
      <static>true</static>
      <pose>0 0 1.0 0 0 0</pose>
      <link name="camera_depth_frame">
        <visual name="body">
          <geometry>
            <box>
              <size>0.25 0.12 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <sensor type="depth" name="camera_sensor">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>B8G8R8</format>
            </image>
            <depth_camera>
            </depth_camera>
            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.003</stddev>
            </noise>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>/depth_camera/points:=/camera/points</remapping>
            </ros>
            <camera_name>depth_camera</camera_name>
            <frame_name>camera_depth_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>20.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
